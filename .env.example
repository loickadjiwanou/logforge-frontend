# ─────────────────────────────────────────────────────────────────────────────
# LogForge Frontend — Environment Variables
# Copy this file to .env and fill in your values before building.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL (no trailing slash)
# Development : http://localhost:8000
# Production  : https://api.yourdomain.com
REACT_APP_BACKEND_URL=https://api.yourdomain.com

# WebSocket base URL (no trailing slash, no path)
# Development : ws://localhost:8000
# Production  : wss://api.yourdomain.com
REACT_APP_WS_URL=wss://api.yourdomain.com

# Enable the /health endpoint check in the webpack dev plugin (development only)
# Set to false in production builds
ENABLE_HEALTH_CHECK=false

# Node environment — set automatically by CRA, do not override manually
# NODE_ENV=production
